// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  EMPLOYEE
  CLIENT
  CONTRACTOR
}

enum WorkspaceRole {
  OWNER
  EMPLOYEE
  CLIENT
  CONTRACTOR
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskActivityType {
  CREATED
  STARTED
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CLIENT)

  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  memberships WorkspaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  members   WorkspaceMember[]
  projects  Project[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model WorkspaceMember {
  id             String          @id @default(uuid())
  workspaceId    String
  userId         String
  role           WorkspaceRole
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       ProjectMember[]
  tasksAssigned  Task[]          @relation("TaskAssigneeRole")
  tasksCreated   Task[]          @relation("TaskCreator")
  taskActivities TaskActivity[]  @relation("TaskActivityActor")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@unique([id, workspaceId, role])
  @@index([workspaceId])
  @@index([userId])
}

model Project {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus   @default(DRAFT)
  startDate   DateTime?
  targetDate  DateTime?
  members     ProjectMember[]
  spaces      ProjectSpace[]
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model ProjectMember {
  id                String          @id @default(uuid())
  projectId         String
  workspaceId       String
  workspaceMemberId String
  project           Project         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspaceMember   WorkspaceMember @relation(fields: [workspaceMemberId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  assignedTasks     Task[]          @relation("TaskAssigneeProjectMember")
  createdAt         DateTime        @default(now())

  @@unique([projectId, workspaceMemberId])
  @@unique([id, workspaceMemberId, projectId, workspaceId])
  @@index([projectId])
  @@index([workspaceMemberId])
}

model Task {
  id                         String        @id @default(uuid())
  projectId                  String
  workspaceId                String
  assigneeProjectMemberId    String
  assigneeWorkspaceMemberId  String
  assigneeRole               WorkspaceRole @default(EMPLOYEE)
  createdByWorkspaceMemberId String
  title                      String
  description                String?
  status                     TaskStatus    @default(TODO)
  priority                   TaskPriority  @default(MEDIUM)
  dueDate                    DateTime?     @db.Date
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  project               Project         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  assigneeProjectMember ProjectMember   @relation("TaskAssigneeProjectMember", fields: [assigneeProjectMemberId, assigneeWorkspaceMemberId, projectId, workspaceId], references: [id, workspaceMemberId, projectId, workspaceId], onDelete: Restrict)
  assignee              WorkspaceMember @relation("TaskAssigneeRole", fields: [assigneeWorkspaceMemberId, workspaceId, assigneeRole], references: [id, workspaceId, role], onDelete: Restrict, onUpdate: Restrict)
  createdBy             WorkspaceMember @relation("TaskCreator", fields: [createdByWorkspaceMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  activities            TaskActivity[]

  @@unique([id, workspaceId])
  @@index([projectId, status, createdAt])
  @@index([assigneeWorkspaceMemberId, status, dueDate])
  @@index([workspaceId, status, updatedAt])
}

model TaskActivity {
  id                     String           @id @default(uuid())
  taskId                 String
  workspaceId            String
  actorWorkspaceMemberId String
  type                   TaskActivityType
  comment                String?
  createdAt              DateTime         @default(now())

  task  Task            @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  actor WorkspaceMember @relation("TaskActivityActor", fields: [actorWorkspaceMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([taskId, createdAt, id])
}

enum HotspotType {
  NAVIGATION
  INFO
}

model ProjectSpace {
  id        String         @id @default(uuid())
  projectId String
  name      String
  sortOrder Int            @default(0)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes    ProjectScene[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([id, projectId])
  @@index([projectId, sortOrder])
}

model ProjectScene {
  id               String         @id @default(uuid())
  projectSpaceId   String
  projectId        String
  name             String
  description      String?
  panoramaUrl      String?
  thumbnailUrl     String?
  sortOrder        Int            @default(0)
  initialYaw       Float?
  initialPitch     Float?
  initialFov       Float?
  space            ProjectSpace   @relation(fields: [projectSpaceId, projectId], references: [id, projectId], onDelete: Cascade)
  hotspots         SceneHotspot[] @relation("SceneHotspots")
  incomingHotspots SceneHotspot[] @relation("NavigationTarget")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([id, projectId])
  @@index([projectSpaceId, sortOrder])
}

model SceneHotspot {
  id            String        @id @default(uuid())
  sceneId       String
  projectId     String
  type          HotspotType
  yaw           Float
  pitch         Float
  title         String?
  description   String?
  targetSceneId String?
  scene         ProjectScene  @relation("SceneHotspots", fields: [sceneId, projectId], references: [id, projectId], onDelete: Cascade)
  targetScene   ProjectScene? @relation("NavigationTarget", fields: [targetSceneId, projectId], references: [id, projectId], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([sceneId])
  @@index([targetSceneId])
}
