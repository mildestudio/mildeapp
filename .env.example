# Copy to .env on the host; generate unique secrets before deployment.
DOMAIN=localhost
PUBLIC_ORIGIN=http://localhost
ACME_EMAIL=admin@example.com
POSTGRES_DB=mildeapp
POSTGRES_USER=mildeapp
POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret
JWT_SECRET=replace-with-a-long-random-hex-secret
JWT_EXPIRES_IN=1d
SWAGGER_ENABLED=false
